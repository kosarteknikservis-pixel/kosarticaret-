{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node scripts/minify-static-assets.mjs",
        "minify:static": "node scripts/minify-static-assets.mjs",
        "dev": "vite",
        "design:check": "npx --yes @enmera/ai-design-check",
        "design:check:shop": "npx --yes @enmera/ai-design-check resources/views/shop resources/views/layouts/shop.blade.php resources/views/components/shop"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "esbuild": "^0.28.0",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
